  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Decisions / Minute",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(risk_decisions_total[1m])) * 60",
          "legendFormat": "Decisions / min",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Model Cascade Fallback Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(risk_fallback_total[1m]))",
          "legendFormat": "Fallbacks / sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Risk Scoring Latency P95",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(risk_decision_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Inference",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Human Review Escalation Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(human_review_required_total[1m]))",
          "legendFormat": "Escalations / sec",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Risk Band Distribution (LOW, MEDIUM, HIGH, CRITICAL)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(risk_band_total[1m])) by (risk_band)",
          "legendFormat": "{{risk_band}} Risk",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Selected Policy Interventions (A0 - A4)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(policy_decisions_total[1m])) by (action)",
          "legendFormat": "Action {{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "ML Model Scoring Source (Tier 0 vs Tier 1 vs Tier 2)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(risk_decisions_total[1m])) by (scoring_source, fallback_tier)",
          "legendFormat": "{{scoring_source}} (Tier {{fallback_tier}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Manual Operator Overrides by Action",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(human_override_total[1m])) by (previous_action, new_action)",
          "legendFormat": "{{previous_action}} -> {{new_action}}",
          "refId": "A"
        }
      ]
    }
  ],
