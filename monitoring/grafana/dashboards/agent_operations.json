  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Agent Workflow Executions (Rate)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(agent_workflow_total[1m]))",
          "legendFormat": "Runs / sec",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Prompt Injection Detections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(prompt_injection_detected_total[1h]))",
          "legendFormat": "Injections Detected (Last 1h)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Agent Workflow Latency P95",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_workflow_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Workflow Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Deterministic Fallback Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(agent_fallback_total[1m]))",
          "legendFormat": "Fallbacks / sec",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Workflow Execution by Provider (GEMINI vs DETERMINISTIC_FALLBACK)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(agent_workflow_total[1m])) by (provider, status)",
          "legendFormat": "{{provider}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Adversarial Prompt Injections Detected Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(prompt_injection_detected_total[1m])) by (agent_name, routing_status)",
          "legendFormat": "Agent: {{agent_name}} (Routed: {{routing_status}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Agent Failures and Timeouts",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(agent_failures_total[1m])) by (agent_name, error_type)",
          "legendFormat": "{{agent_name}} ({{error_type}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Agent Human Escalation Reasons",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(agent_human_review_total[1m])) by (reason)",
          "legendFormat": "Escalation: {{reason}}",
          "refId": "A"
        }
      ]
    }
  ],
